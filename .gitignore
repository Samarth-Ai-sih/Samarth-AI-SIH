*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
\.venv*/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ---------- Node / Next.js ----------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ---------- Docker ----------
docker-compose.override.yml

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- ML artifacts ----------
*.joblib
*.pkl
*.h5
*.onnx
models/*.joblib

# ---------- Logs ----------
*.log
logs/

# ---------- OS ----------
desktop.ini
ehthumbs.db

# ---------- Private Evidence & Scratch ----------
private_citizen_evidence/
scratch/
