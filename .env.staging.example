# SAMARTH AI staging deployment template — values shown are placeholders only.
APP_NAME=SAMARTH AI Staging
APP_VERSION=0.1.0
ENVIRONMENT=staging
DEBUG=false

MONGODB_URI=mongodb+srv://STAGING_USER:REPLACE_ME@STAGING_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=samarth_ai_staging
REDIS_URL=rediss://:REPLACE_ME@STAGING_REDIS_HOST:6380/0
CELERY_BROKER_URL=rediss://:REPLACE_ME@STAGING_REDIS_HOST:6380/1
CELERY_RESULT_BACKEND=rediss://:REPLACE_ME@STAGING_REDIS_HOST:6380/2

JWT_SECRET_KEY=REPLACE_WITH_A_64_CHARACTER_RANDOM_SECRET
CSRF_SECRET_KEY=REPLACE_WITH_A_SEPARATE_64_CHARACTER_RANDOM_SECRET
COOKIE_DOMAIN=
CORS_ORIGINS=https://staging.example.invalid
TRUST_PROXY_HEADERS=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_WHATSAPP_ENABLED=false
LOG_LEVEL=INFO
LOG_FORMAT=json
