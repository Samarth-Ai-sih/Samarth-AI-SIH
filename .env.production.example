# SAMARTH AI production deployment template — do not commit populated values.
APP_NAME=SAMARTH AI
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false

MONGODB_URI=mongodb+srv://PRODUCTION_USER:REPLACE_ME@PRODUCTION_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=samarth_ai
REDIS_URL=rediss://:REPLACE_ME@PRODUCTION_REDIS_HOST:6380/0
CELERY_BROKER_URL=rediss://:REPLACE_ME@PRODUCTION_REDIS_HOST:6380/1
CELERY_RESULT_BACKEND=rediss://:REPLACE_ME@PRODUCTION_REDIS_HOST:6380/2

JWT_SECRET_KEY=REPLACE_WITH_A_64_CHARACTER_RANDOM_SECRET
CSRF_SECRET_KEY=REPLACE_WITH_A_SEPARATE_64_CHARACTER_RANDOM_SECRET
COOKIE_DOMAIN=.example.invalid
CORS_ORIGINS=https://app.example.invalid
TRUST_PROXY_HEADERS=true

CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_WHATSAPP_ENABLED=false
LOG_LEVEL=WARNING
LOG_FORMAT=json
