# =============================================
# SAMARTH AI — Environment Configuration
# Copy to .env and fill in required values
# =============================================

# ── Application ──────────────────────────────────────────────
APP_NAME=SAMARTH AI
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# ── MongoDB Atlas (REQUIRED) ────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?appName=samarthAI
MONGODB_DB_NAME=samarth_ai
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
# Optional developer-only local fallback. Leave blank for Atlas-only operation.
# It is rejected when ENVIRONMENT=production.
MONGODB_DEV_FALLBACK_URI=
# Set only for a local demo when Atlas is unavailable. It is rejected outside
# development, and should never be committed with a real environment file.
MONGODB_USE_DEV_FALLBACK=false

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_MAX_RETRIES=4
CELERY_SLA_WARNING_HOURS=24

# ── Notification adapters (external transport disabled by default) ──
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_WHATSAPP_ENABLED=false

# ── JWT Authentication (REQUIRED) ───────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Leave blank to derive the CSRF signing secret from JWT_SECRET_KEY. Set a
# separate random value for production rotation independence.
CSRF_SECRET_KEY=

# ── Session cookie scope ────────────────────────────────────────
# Empty for localhost. Use only the application parent domain in production,
# for example .example.gov.in; do not include a protocol or path.
COOKIE_DOMAIN=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Request protections ──────────────────────────────────────
# Keep false unless the app is deployed behind a proxy that sanitises
# X-Forwarded-For before it reaches this service.
TRUST_PROXY_HEADERS=false
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PUBLIC_ISSUE_MAX=10
RATE_LIMIT_PUBLIC_ISSUE_WINDOW_SECONDS=3600
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=900

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Evidence verification (Phase 12) ───────────────────────────
# Empty Cloudinary values activate the private local demo-file fallback only in
# development/staging. Production rejects uploads until a provider is set.
EVIDENCE_GPS_TOLERANCE_METERS=500
EVIDENCE_TIMESTAMP_TOLERANCE_DAYS=30
EVIDENCE_PHASH_DISTANCE_THRESHOLD=8

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | text

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Frontend (used by docker-compose) ───────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Demo seeding (development only) ─────────────────────────────
# Seed users never have source-code defaults. Populate all of these with
# unique values through your local secret manager before running seed_users.
# Do not commit populated values or reuse local/demo values outside development.
SEED_FORCE_PASSWORD_CHANGE=true
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MOSPI_EMAIL=
SEED_MOSPI_PASSWORD=
SEED_SNO_EMAIL=
SEED_SNO_PASSWORD=
SEED_DA_EMAIL=
SEED_DA_PASSWORD=
SEED_INSPECTOR_EMAIL=
SEED_INSPECTOR_PASSWORD=
SEED_MP_EMAIL=
SEED_MP_PASSWORD=
SEED_AGENCY_EMAIL=
SEED_AGENCY_PASSWORD=
SEED_CITIZEN_EMAIL=
SEED_CITIZEN_PASSWORD=
